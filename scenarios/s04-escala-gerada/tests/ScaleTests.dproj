<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{05CC2806-B9F6-544E-BF52-5BE276B52C09}</ProjectGuid>
        <ProjectVersion>19.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <AppType>Console</AppType>
        <MainSource>ScaleTests.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <TargetedPlatforms>2</TargetedPlatforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>ScaleTests</SanitizedProjectName>
        <DCC_DcuOutput>.\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_UnitSearchPath>;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\src\uGen00.pas"/>
        <DCCReference Include="..\src\uGen01.pas"/>
        <DCCReference Include="..\src\uGen02.pas"/>
        <DCCReference Include="..\src\uGen03.pas"/>
        <DCCReference Include="..\src\uGen04.pas"/>
        <DCCReference Include="..\src\uGen05.pas"/>
        <DCCReference Include="..\src\uGen06.pas"/>
        <DCCReference Include="..\src\uGen07.pas"/>
        <DCCReference Include="..\src\uGen08.pas"/>
        <DCCReference Include="..\src\uGen09.pas"/>
        <DCCReference Include="..\src\uGen10.pas"/>
        <DCCReference Include="..\src\uGen11.pas"/>
        <DCCReference Include="..\src\uGen12.pas"/>
        <DCCReference Include="..\src\uGen13.pas"/>
        <DCCReference Include="..\src\uGen14.pas"/>
        <DCCReference Include="..\src\uGen15.pas"/>
        <DCCReference Include="..\src\uGen16.pas"/>
        <DCCReference Include="..\src\uGen17.pas"/>
        <DCCReference Include="..\src\uGen18.pas"/>
        <DCCReference Include="..\src\uGen19.pas"/>
        <DCCReference Include="TestGen00.pas"/>
        <DCCReference Include="TestGen01.pas"/>
        <DCCReference Include="TestGen02.pas"/>
        <DCCReference Include="TestGen03.pas"/>
        <DCCReference Include="TestGen04.pas"/>
        <DCCReference Include="TestGen05.pas"/>
        <DCCReference Include="TestGen06.pas"/>
        <DCCReference Include="TestGen07.pas"/>
        <DCCReference Include="TestGen08.pas"/>
        <DCCReference Include="TestGen09.pas"/>
        <DCCReference Include="TestGen10.pas"/>
        <DCCReference Include="TestGen11.pas"/>
        <DCCReference Include="TestGen12.pas"/>
        <DCCReference Include="TestGen13.pas"/>
        <DCCReference Include="TestGen14.pas"/>
        <DCCReference Include="TestGen15.pas"/>
        <DCCReference Include="TestGen16.pas"/>
        <DCCReference Include="TestGen17.pas"/>
        <DCCReference Include="TestGen18.pas"/>
        <DCCReference Include="TestGen19.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">ScaleTests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
